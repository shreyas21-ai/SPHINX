# -----------------------------------------------------------------------
# Project SPHINX — Environment Configuration Example
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

FLASK_APP=wsgi.py
FLASK_ENV=development

# Flask and JWT session secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# AES-256-GCM encryption key and HMAC blind-index key — must be different.
# Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SPHINX_AES_SECRET_KEY=replace-with-base64-encoded-32-byte-key
SPHINX_HMAC_SECRET_KEY=replace-with-a-separate-base64-encoded-32-byte-key

# Database — use SQLite for quick start, MySQL for full demo
# SQLite (no server needed):
DATABASE_URL=sqlite:///sphinx_dev.db
# MySQL (create the DB first: CREATE DATABASE sphinx CHARACTER SET utf8mb4;):
# DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/sphinx

# Test database (pytest uses SQLite by default; override here only if needed)
# TEST_DATABASE_URL=sqlite:///:memory:

# Admin account seeded by scripts/bootstrap_admin.py
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password